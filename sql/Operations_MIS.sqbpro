<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Operations_MIS.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2069"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="clean_data" custom_title="0" dock_id="1" table="4,10:mainclean_data"/><dock_state state="000000ff00000000fd00000001000000020000039100000260fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003910000013300ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="clean_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="87"/><column index="3" value="143"/><column index="4" value="62"/><column index="5" value="79"/><column index="6" value="131"/><column index="7" value="137"/><column index="8" value="75"/><column index="9" value="98"/><column index="10" value="83"/><column index="11" value="42"/><column index="12" value="74"/><column index="13" value="123"/><column index="14" value="137"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    COUNT(*) AS Total_Records,
    SUM(Interactions_Handled) AS Total_Interactions_Handled,
    SUM(Interactions_Resolved) AS Total_Interactions_Resolved,
    ROUND(
        100.0 * SUM(Interactions_Resolved) /
        SUM(Interactions_Handled), 2
    ) AS Resolution_Rate_Percent,
    ROUND(
        100.0 * SUM(SLA_Met_Count) /
        SUM(SLA_Eligible), 2
    ) AS SLA_Achievement_Percent,
    ROUND(AVG(AHT_Minutes), 2) AS Average_Handling_Time,
    SUM(Errors) AS Total_Errors,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data;</sql><sql name="SQL 2*">SELECT
    Team,
    COUNT(*) AS Total_Records,
    SUM(Interactions_Handled) AS Interactions_Handled,
    SUM(Interactions_Resolved) AS Interactions_Resolved,
    ROUND(
        100.0 * SUM(Interactions_Resolved) /
        SUM(Interactions_Handled), 2
    ) AS Resolution_Rate_Percent,
    ROUND(
        100.0 * SUM(SLA_Met_Count) /
        SUM(SLA_Eligible), 2
    ) AS SLA_Achievement_Percent,
    ROUND(AVG(AHT_Minutes), 2) AS Average_Handling_Time,
    SUM(Errors) AS Total_Errors,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data
GROUP BY Team
ORDER BY Interactions_Handled DESC;</sql><sql name="SQL 3*">SELECT
    Agent_ID,
    COUNT(DISTINCT Team) AS Teams_Assigned,
    SUM(Interactions_Handled) AS Interactions_Handled,
    SUM(Interactions_Resolved) AS Interactions_Resolved,
    ROUND(
        100.0 * SUM(Interactions_Resolved) /
        NULLIF(SUM(Interactions_Handled), 0), 2
    ) AS Resolution_Rate_Percent,
    ROUND(AVG(AHT_Minutes), 2) AS Average_Handling_Time,
    SUM(Errors) AS Total_Errors,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data
GROUP BY Agent_ID
ORDER BY Resolution_Rate_Percent DESC;</sql><sql name="SQL 4*">SELECT
    Shift,
    COUNT(*) AS Total_Records,
    SUM(Interactions_Handled) AS Interactions_Handled,
    SUM(Interactions_Resolved) AS Interactions_Resolved,
    ROUND(
        100.0 * SUM(Interactions_Resolved) /
        NULLIF(SUM(Interactions_Handled), 0), 2
    ) AS Resolution_Rate_Percent,
    ROUND(AVG(AHT_Minutes), 2) AS Average_Handling_Time,
    SUM(Errors) AS Total_Errors,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data
GROUP BY Shift
ORDER BY Interactions_Handled DESC;</sql><sql name="SQL 5*">SELECT
    Date,
    COUNT(*) AS Total_Records,
    SUM(Interactions_Handled) AS Interactions_Handled,
    SUM(Interactions_Resolved) AS Interactions_Resolved,
    ROUND(
        100.0 * SUM(Interactions_Resolved) /
        NULLIF(SUM(Interactions_Handled), 0), 2
    ) AS Resolution_Rate_Percent,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data
GROUP BY Date
ORDER BY Date;</sql><sql name="SQL 6*">SELECT
    Team,
    SUM(SLA_Eligible) AS Total_SLA_Eligible,
    SUM(SLA_Met_Count) AS Total_SLA_Met,
    SUM(SLA_Eligible) - SUM(SLA_Met_Count) AS SLA_Missed,
    ROUND(
        100.0 * SUM(SLA_Met_Count) /
        NULLIF(SUM(SLA_Eligible), 0), 2
    ) AS SLA_Achievement_Percent
FROM clean_data
GROUP BY Team
ORDER BY SLA_Achievement_Percent DESC;</sql><sql name="SQL 7*">SELECT
    Team,
    Shift,
    SUM(Errors) AS Total_Errors,
    COUNT(*) AS Total_Records,
    ROUND(AVG(Errors), 2) AS Average_Errors_Per_Record
FROM clean_data
GROUP BY Team, Shift
ORDER BY Total_Errors DESC;</sql><sql name="SQL 8*">SELECT
    Team,
    COUNT(*) AS Total_Records,
    SUM(CASE WHEN Attendance = 'Present' THEN 1 ELSE 0 END) AS Present_Count,
    SUM(CASE WHEN Attendance = 'Absent' THEN 1 ELSE 0 END) AS Absent_Count,
    SUM(CASE WHEN Attendance = 'Late' THEN 1 ELSE 0 END) AS Late_Count,
    ROUND(
        100.0 * SUM(CASE WHEN Attendance = 'Present' THEN 1 ELSE 0 END) /
        COUNT(*), 2
    ) AS Attendance_Rate_Percent,
    ROUND(AVG(Customer_Satisfaction), 2) AS Average_CSAT
FROM clean_data
GROUP BY Team
ORDER BY Attendance_Rate_Percent DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
